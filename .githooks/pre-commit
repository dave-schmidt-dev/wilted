#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Git exports GIT_DIR and friends to hooks; the tests below create their own
# repositories and would otherwise write into this one (it set core.bare once).
unset $(git rev-parse --local-env-vars)
exec make -C "$repo_root" check-fast
