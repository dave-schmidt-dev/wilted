{
  "schemaVersion": "1.0.0",
  "workflow": {"coreVersion": "1.0.0", "profile": "appleTestFlightV2", "profileVersion": "2.0.0"},
  "obligations": [
    {"operationClass":"identityAllocation","task":"Allocate an exact Wilted build identity","command":["app/release-testflight","--prepare-only"],"evidencePath":".release-state/evidence/allocate-identity.json","stopCondition":"identity allocation rejects the fixed app identity","dependencies":[],"phaseGate":"candidate is immutable"},
    {"operationClass":"sourceSnapshot","task":"Freeze the candidate source","command":["app/release-testflight","--prepare-only"],"evidencePath":".git/release-state/wilted-ios/candidates/{candidateId}/manifest.json","stopCondition":"candidate source cannot be frozen","dependencies":["identityAllocation"],"phaseGate":"source digest is sealed"},
    {"operationClass":"readiness","task":"Confirm release readiness","command":["python3","app/release_stage_readiness.py"],"evidencePath":".release-state/evidence/{candidateId}/readiness.json","stopCondition":"readiness checks fail","dependencies":["sourceSnapshot"],"phaseGate":"readiness proof passes"},
    {"operationClass":"localGate","task":"Run the authoritative local gate","command":["bash","app/release_local_gate.sh"],"evidencePath":".release-state/evidence/{candidateId}/local-gate.json","stopCondition":"release test gate fails","dependencies":["readiness"],"phaseGate":"production local gate passes"},
    {"operationClass":"productionReleaseBuild","task":"Build the production IPA","command":["bash","app/archive-upload-ios.sh","--prepare-only"],"evidencePath":".release-state/evidence/{candidateId}/production-build.json","stopCondition":"production build fails","dependencies":["localGate"],"phaseGate":"production artifact exists"},
    {"operationClass":"archive","task":"Archive the iOS application","command":["bash","app/archive-upload-ios.sh","--prepare-only"],"evidencePath":".release-state/evidence/{candidateId}/archive.json","stopCondition":"archive fails","dependencies":["productionReleaseBuild"],"phaseGate":"archive proof passes"},
    {"operationClass":"sign","task":"Sign the archive for App Store Connect","command":["bash","app/archive-upload-ios.sh","--prepare-only"],"evidencePath":".release-state/evidence/{candidateId}/signing.json","stopCondition":"distribution signing fails","dependencies":["archive"],"phaseGate":"signing proof passes"},
    {"operationClass":"artifactVerify","task":"Verify the signed IPA","command":["bash","app/archive-upload-ios.sh","--prepare-only"],"evidencePath":".release-state/evidence/{candidateId}/artifact.json","stopCondition":"artifact verification fails","dependencies":["sign"],"phaseGate":"signed artifact proof passes"},
    {"operationClass":"buildLookup","task":"Reconcile the exact candidate build before upload","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/build-lookup.json","stopCondition":"exact build lookup is ambiguous or malformed","dependencies":["artifactVerify"],"phaseGate":"lookup proof records absent or the exact remote build"},
    {"operationClass":"upload","task":"Upload the verified IPA","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/upload.json","stopCondition":"App Store Connect upload fails","dependencies":["buildLookup"],"phaseGate":"upload receipt exists"},
    {"operationClass":"processing","task":"Poll the exact uploaded build","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/processing.json","stopCondition":"Apple processing fails or times out","dependencies":["upload"],"phaseGate":"build is VALID"},
    {"operationClass":"compliance","task":"Complete export-compliance status","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/compliance.json","stopCondition":"compliance status cannot be recorded","dependencies":["processing"],"phaseGate":"compliance proof passes"},
    {"operationClass":"testerGroup","task":"Resolve the internal tester group","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/tester-group.json","stopCondition":"internal tester group is unavailable","dependencies":["compliance"],"phaseGate":"tester group proof passes"},
    {"operationClass":"assignmentReconcile","task":"Confirm whether the exact build is already assigned to the fixed internal tester group","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/assignment-reconcile.json","stopCondition":"assignment lookup is ambiguous, malformed, or cannot bind the exact group and build","dependencies":["testerGroup"],"phaseGate":"assignment reconciliation records absent or the exact assigned build"},
    {"operationClass":"assignment","task":"Assign the build to internal testing","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/assignment.json","stopCondition":"build assignment fails","dependencies":["assignmentReconcile"],"phaseGate":"assignment proof passes"},
    {"operationClass":"deviceHealth","task":"Record post-assignment device health","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/device-health.json","stopCondition":"device health cannot be verified","dependencies":["assignment"],"phaseGate":"device health proof passes"},
    {"operationClass":"notification","task":"Notify the internal testing release","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/notification.json","stopCondition":"notification cannot be sent","dependencies":["deviceHealth"],"phaseGate":"notification proof passes"},
    {"operationClass":"receipt","task":"Write the TestFlight receipt","command":["app/release-testflight","--upload"],"evidencePath":".release-state/evidence/{candidateId}/receipt.json","stopCondition":"release receipt cannot be written","dependencies":["notification"],"phaseGate":"internal TestFlight receipt exists"}
  ],
  "manualBoundaries": ["Apple build processing and TestFlight service availability"],
  "knownOfflineLimitations": ["real-tool-canary-required"]
}
