.verifier_prompt.md
spikes/

# Personal opencode agent-permission config
opencode.jsonc

# Attended Development CloudKit qualification builds and logs
.attended-build/

# Ad-hoc verification scratch: Xcode derived data from focused reruns
.verify-tmp/

# Deployer-local configuration: holds the operator location and contact.
# Never commit -- this repository is public.
wilted.toml
**/wilted.toml

# Preparation runtime: deployer-local state and test artifacts. The data tree is
# the operator's own library (audio, transcripts, feeds), never a project asset.
Producer/Runtime/data/
Producer/Runtime/snapshot_report.html
Producer/Runtime/.coverage

# Ad-corpus inputs: aligned podcast transcripts are third-party copyrighted
# content and this repository is public. The pinned store lives outside the
# repository under ~/Library/Application Support/Wilted/adcorpus-inputs/; a
# repo-internal copy must never be collected either.
adcorpus-inputs/
**/adcorpus-inputs/
Producer/Workers/adcorpus/inputs/

# Editable-install metadata regenerated by any `pip install -e Producer/Runtime`.
*.egg-info/
